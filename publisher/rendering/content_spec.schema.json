{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://f1immobiliare.com/schemas/content-spec-v2.json",
  "title": "F1 ContentSpec V2",
  "type": "object",
  "required": ["type", "content"],
  "properties": {
    "type": {
      "type": "string",
      "enum": ["static", "photo", "carousel", "reel", "video", "story", "ugc"]
    },
    "format": {
      "type": "string",
      "enum": ["1:1", "4:5", "9:16", "16:9"]
    },
    "template": {"type": "string"},
    "brand": {
      "type": "object",
      "properties": {
        "name": {"type": "string"},
        "tagline": {"type": "string"},
        "primary": {"type": "string"},
        "secondary": {"type": "string"},
        "background": {"type": "string"},
        "foreground": {"type": "string"},
        "phone_primary": {"type": "string"},
        "phone_secondary": {"type": "string"},
        "site": {"type": "string"},
        "address": {"type": "string"}
      },
      "additionalProperties": true
    },
    "content": {
      "type": "object",
      "properties": {
        "title": {"type": "string"},
        "subtitle": {"type": "string"},
        "body": {"type": "string"},
        "cta": {"type": "string"},
        "duration_s": {"type": "number", "minimum": 1, "maximum": 120},
        "slides": {
          "type": "array",
          "items": {
            "oneOf": [
              {"type": "string"},
              {
                "type": "object",
                "properties": {
                  "title": {"type": "string"},
                  "subtitle": {"type": "string"},
                  "body": {"type": "string"},
                  "cta": {"type": "string"},
                  "image": {"type": "string"}
                },
                "additionalProperties": true
              }
            ]
          }
        }
      },
      "additionalProperties": true
    },
    "assets": {
      "type": "object",
      "properties": {
        "images": {"type": "array", "items": {"type": "string"}},
        "videos": {"type": "array", "items": {"type": "string"}},
        "logo": {"type": "string"}
      },
      "additionalProperties": true
    },
    "audio": {
      "type": "object",
      "properties": {
        "voiceover": {"type": "string"},
        "music": {"type": "string"}
      },
      "additionalProperties": true
    },
    "captions": {
      "type": "object",
      "properties": {
        "enabled": {"type": "boolean"},
        "items": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["text", "start", "end"],
            "properties": {
              "text": {"type": "string"},
              "start": {"type": "number"},
              "end": {"type": "number"}
            }
          }
        }
      },
      "additionalProperties": true
    },
    "output": {
      "type": "object",
      "properties": {
        "path": {"type": "string"},
        "quality": {"type": "integer", "minimum": 1, "maximum": 100}
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": true
}
