# Copy to postiz.env on the server. NEVER commit postiz.env.
# Multi-client production target. Override if you prefer another hostname.
POSTIZ_DOMAIN=social.realmediapro.it
POSTIZ_IMAGE=ghcr.io/gitroomhq/postiz-app:v2.22.1
MAIN_URL=https://social.realmediapro.it
FRONTEND_URL=https://social.realmediapro.it
NEXT_PUBLIC_BACKEND_URL=https://social.realmediapro.it/api
JWT_SECRET=CHANGE_ME_WITH_A_LONG_RANDOM_SECRET
DISABLE_REGISTRATION=true
API_LIMIT=100
STORAGE_PROVIDER=local

# Meta: one Meta app can serve Facebook + Instagram FB-linked.
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=

# Optional Instagram standalone app.
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=

LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
TIKTOK_CLIENT_ID=
TIKTOK_CLIENT_SECRET=
PINTEREST_CLIENT_ID=
PINTEREST_CLIENT_SECRET=

# Optional AI generation inside Postiz itself.
OPENAI_API_KEY=
